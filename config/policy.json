{
  "schema_version": 2,
  "lanes": {
    "luna_low": {
      "model_family": "GPT-6 Luna",
      "reasoning": "low"
    },
    "luna_high": {
      "model_family": "GPT-6 Luna",
      "reasoning": "high"
    },
    "astra_high": {
      "model_family": "GPT-6 Astra",
      "reasoning": "high"
    },
    "pro_web": {
      "model_family": "GPT-6 Pro",
      "reasoning": null,
      "transport": "chatgpt_web",
      "skill": "prepare-sol-pro-architecture-review"
    },
    "opus_medium": {
      "model_family": "Claude Opus 5.5",
      "reasoning": "medium"
    },
    "opus_high": {
      "model_family": "Claude Opus 5.5",
      "reasoning": "high"
    }
  },
  "complexity_floor": {
    "routine": "luna_low",
    "bounded": "luna_high",
    "medium_tough": "astra_high",
    "tough": "pro_web"
  },
  "mandatory_pro_categories": [
    "architecture",
    "research",
    "security_design",
    "migration_design",
    "irreversible_change_design"
  ],
  "max_passes_per_lane": 2,
  "max_coding_passes": 6,
  "max_no_progress_passes": 2,
  "debate": {
    "review_repository_name": "GPT-Pro-Escalation",
    "required_roles": [
      "pro",
      "claude"
    ],
    "same_chat_for_pro": true,
    "max_rounds_per_run": 6,
    "max_nonprogress_rounds": 2,
    "on_budget_exhausted": "PAUSED",
    "matching_solution_digests": true,
    "skill": "fable-adversarial-review",
    "claude_models": [
      "claude-fable-5-1",
      "claude-opus-5-5"
    ],
    "participant_change_invalidates_approvals": true
  },
  "clm": {
    "mode": "shadow",
    "local_only": true,
    "can_lower_floor": false,
    "can_authorize_completion": false
  },
  "verification": {
    "nonempty_required_checks": true,
    "same_snapshot_and_plan": true,
    "all_observed_failures_block": true
  },
  "pro_transport": {
    "default": "manual",
    "automatic_requires_permitted_capability": true,
    "no_restriction_bypass": true,
    "no_silent_model_substitution": true
  },
  "tier_peers": {
    "medium_tough": [
      "astra_high",
      "opus_medium",
      "opus_high"
    ]
  },
  "billing": {
    "remote_mode": "subscription_only",
    "api_fallback": false,
    "optimize": "verified_completions_per_observed_quota",
    "api_to_quota_conversion": false
  },
  "effort": {
    "lease_generations": [
      1,
      2,
      5,
      10
    ],
    "default_lease": 2,
    "apply_only_at_generation_boundary": true,
    "effective_setting_readback_required": true,
    "manual_override_wins": true
  }
}
