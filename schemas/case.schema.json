{
 "$schema":"https://json-schema.org/draft/2020-12/schema","title":"Case v2: exact participant and harness binding","type":"object","additionalProperties":false,
 "$defs":{"digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}},
 "required":["schema_version","case_id","status","branch","requirements_digest","bundle_digest","solution_digest","rounds_total","next_actor","reviewer_identity","participant_binding_digest","harness_profile"],
 "properties":{
  "schema_version":{"const":2},"case_id":{"type":"string","pattern":"^case-[A-Za-z0-9-]+$"},
  "status":{"enum":["PREPARED","WAIT_CAPABILITY","WAIT_ENVIRONMENT","WAIT_HUMAN","PRO_PENDING","PRO_READY","REVIEWER_PENDING","PRO_REVIEW_PENDING","PAUSED","CONVERGED","LOCAL_RECONCILIATION","IMPLEMENTING","VERIFIED","CLOSED","CANCELLED"]},
  "branch":{"type":"string","pattern":"^case/case-[A-Za-z0-9-]+$"},
  "requirements_digest":{"$ref":"#/$defs/digest"},"bundle_digest":{"$ref":"#/$defs/digest"},"solution_digest":{"anyOf":[{"$ref":"#/$defs/digest"},{"type":"null"}]},
  "rounds_total":{"type":"integer","minimum":0},"next_actor":{"enum":["coordinator","pro","reviewer","owner"]},
  "reviewer_identity":{"enum":["claude-fable-5-1","claude-opus-5-5"]},"participant_binding_digest":{"$ref":"#/$defs/digest"},"harness_profile":{"enum":["codex","pi"]}
 }
}
