{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "title":"Participant-bound convergence inputs; validation does not prove participation",
 "type":"object","additionalProperties":false,
 "$defs":{
  "digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
  "role":{"enum":["pro","reviewer"]},
  "review":{"type":"object","additionalProperties":false,"required":["role","verdict","solution_digest","requirements_digest","bundle_digest","receipt_id"],"properties":{"role":{"$ref":"#/$defs/role"},"verdict":{"enum":["APPROVE","REVISE","BLOCKED"]},"solution_digest":{"$ref":"#/$defs/digest"},"requirements_digest":{"$ref":"#/$defs/digest"},"bundle_digest":{"$ref":"#/$defs/digest"},"receipt_id":{"type":"string","minLength":1}}},
  "receipt":{"type":"object","additionalProperties":false,"required":["receipt_id","case_id","role","phase","sequence","identity_verified","durable_output_verified","participant_identity","participant_binding_digest"],"properties":{"receipt_id":{"type":"string","minLength":1},"case_id":{"type":"string","minLength":1},"role":{"$ref":"#/$defs/role"},"phase":{"enum":["initial","reviewer_challenge","pro_response","review"]},"sequence":{"type":"integer","minimum":1},"identity_verified":{"type":"boolean"},"durable_output_verified":{"type":"boolean"},"participant_identity":{"enum":["gpt-6-pro-web","claude-fable-5-1","claude-opus-5-5"]},"participant_binding_digest":{"$ref":"#/$defs/digest"}}}
 },
 "required":["case_id","solution_digest","requirements_digest","bundle_digest","reviews","receipts","unresolved_blockers","manifest_verified","evidence_references_verified","required_deliverables_present","reviewer_identity","participant_binding_digest"],
 "properties":{
  "case_id":{"type":"string","minLength":1},"solution_digest":{"$ref":"#/$defs/digest"},"requirements_digest":{"$ref":"#/$defs/digest"},"bundle_digest":{"$ref":"#/$defs/digest"},
  "reviews":{"type":"array","items":{"$ref":"#/$defs/review"}},"receipts":{"type":"array","items":{"$ref":"#/$defs/receipt"}},
  "unresolved_blockers":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
  "manifest_verified":{"type":"boolean"},"evidence_references_verified":{"type":"boolean"},"required_deliverables_present":{"type":"boolean"},
  "reviewer_identity":{"enum":["claude-fable-5-1","claude-opus-5-5"]},"participant_binding_digest":{"$ref":"#/$defs/digest"}
 }
}
