{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exact solution content manifest",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Content item",
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "solution_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "files",
    "solution_digest"
  ],
  "additionalProperties": false
}
