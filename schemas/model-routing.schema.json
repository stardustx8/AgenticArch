{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/stardustx8/AgenticArch/schemas/model-routing.schema.json",
  "title": "AgenticArch CLM routing catalog v2",
  "type": "object",
  "required": [
    "schema_version",
    "mode",
    "checked_at",
    "models",
    "routes",
    "decisions",
    "optimization",
    "priors",
    "hard_policy",
    "evidence_registry"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "mode": {
      "enum": [
        "shadow",
        "advisory"
      ]
    },
    "checked_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "models": {
      "type": "object",
      "minProperties": 6,
      "additionalProperties": {
        "$ref": "#/$defs/model"
      }
    },
    "routes": {
      "type": "object",
      "minProperties": 8,
      "additionalProperties": {
        "$ref": "#/$defs/route"
      }
    },
    "decisions": {
      "type": "object",
      "required": [
        "route",
        "effort_lease"
      ]
    },
    "optimization": {
      "type": "object",
      "required": [
        "price_conversion_allowed"
      ],
      "properties": {
        "price_conversion_allowed": {
          "const": false
        }
      }
    },
    "priors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "domain",
          "basis",
          "strength"
        ]
      }
    },
    "hard_policy": {
      "const": "policy.json"
    },
    "evidence_registry": {
      "const": "research-evidence.json"
    }
  },
  "$defs": {
    "model": {
      "type": "object",
      "required": [
        "identity",
        "display",
        "status",
        "allowed_efforts",
        "default_effort",
        "evidence_ids"
      ],
      "properties": {
        "identity": {
          "type": [
            "string",
            "null"
          ]
        },
        "display": {
          "type": "string"
        },
        "status": {
          "enum": [
            "released",
            "pending"
          ]
        },
        "allowed_efforts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "low",
              "medium",
              "high",
              null
            ]
          }
        },
        "default_effort": {
          "enum": [
            "low",
            "medium",
            "high",
            null
          ]
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "route": {
      "type": "object",
      "required": [
        "model",
        "effort",
        "tier",
        "role",
        "methods",
        "description",
        "local_quality",
        "quota_evidence"
      ],
      "properties": {
        "model": {
          "enum": [
            "luna",
            "astra",
            "opus",
            "fable",
            "pro"
          ]
        },
        "effort": {
          "enum": [
            "low",
            "medium",
            "high",
            null
          ]
        },
        "tier": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "role": {
          "enum": [
            "implementation",
            "deep_anchor",
            "deep_partner"
          ]
        },
        "methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "codex_subscription",
              "claude_code_subscription",
              "chatgpt_web_subscription",
              "pi_openai_subscription"
            ]
          }
        },
        "description": {
          "type": "string",
          "minLength": 20
        },
        "local_quality": {
          "type": "string"
        },
        "quota_evidence": {
          "type": "string"
        }
      }
    }
  }
}
