[Unit]
Description=AgenticArch CLM encoder (vLLM Qwen3-8B pooling, loopback)
After=network.target

[Service]
Environment=HF_HUB_DISABLE_TELEMETRY=1
Environment=VLLM_NO_USAGE_STATS=1
ExecStart=%h/.local/share/agenticarch/clm-venv/bin/vllm serve Qwen/Qwen3-8B --served-model-name qwen3-8b --runner pooling --max-model-len 2048 --host 127.0.0.1 --port 8090 --gpu-memory-utilization 0.25
Restart=on-failure
RestartSec=20

[Install]
WantedBy=default.target
