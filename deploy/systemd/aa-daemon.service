[Unit]
Description=AgenticArch coordinator daemon (aa)
After=network-online.target aa-clm.service

[Service]
ExecStart=/usr/bin/python3 %h/dev/AgenticArch/bin/aa daemon
Restart=on-failure
RestartSec=15
# Workers inherit this environment; API-key variables are scrubbed per job anyway.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Worker code and its tests run inside this cgroup. A runaway test (lab 2026-09-26: 107 GB)
# must not take the workstation down: cap memory, never swap, and on OOM let the kernel
# kill only the offending process (the check then fails) instead of stopping the daemon.
MemoryMax=48G
MemorySwapMax=0
OOMPolicy=continue

[Install]
WantedBy=default.target
